# Copy to server/.env (git-ignored) and fill in. Never commit real values.
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas → Connect → Drivers). No database name needed here;
# it comes from MONGO_DB so dev and prod data stay in separate databases (ADR-020).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=collabboard-dev

# 64+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional (Phase 8): enables multi-instance sockets
REDIS_URL=

LOG_LEVEL=info
